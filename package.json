{
  "name": "woodkit-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Photoshop for designing physical wooden construction kits — 2D design + connectors + 3D assembly.",
  "type": "module",
  "scripts": {
    "dev": "vite",
