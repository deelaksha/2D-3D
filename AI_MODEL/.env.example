# Local LLM Configuration (Ollama with Qwen or custom fine-tuned model)
LLM_PROVIDER=ollama
LLM_MODEL=qwen-house-3d
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60

# 3D Model Generation Pipeline
THREED_PROVIDER=mock

# Storage & App Settings
DATABASE_PATH=data/app.db
OUTPUTS_DIR=outputs
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
